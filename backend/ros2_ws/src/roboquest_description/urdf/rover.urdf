<?xml version="1.0"?>
<robot name="rover_mk1">
  <material name="shell"><color rgba="0.77 0.83 0.82 1"/></material>
  <material name="teal"><color rgba="0.12 0.78 0.66 1"/></material>
  <material name="rubber"><color rgba="0.07 0.09 0.10 1"/></material>
  <material name="metal"><color rgba="0.32 0.39 0.41 1"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.05"/><geometry><box size="0.62 0.44 0.16"/></geometry><material name="shell"/></visual>
    <visual><origin xyz="0 0 0.145"/><geometry><box size="0.52 0.38 0.035"/></geometry><material name="teal"/></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><box size="0.62 0.44 0.16"/></geometry></collision>
    <inertial><origin xyz="0 0 0.05"/><mass value="12"/><inertia ixx="0.2192" ixy="0" ixz="0" iyy="0.41" iyz="0" izz="0.578"/></inertial>
  </link>
  <joint name="base_ground" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.16"/>
  </joint>

  <link name="left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.075"/></geometry><material name="rubber"/></visual>
    <visual><origin xyz="0 0.045 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.065" length="0.012"/></geometry><material name="teal"/></visual>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.26 0"/><axis xyz="0 1 0"/>
  </joint>
  <link name="right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.15" length="0.075"/></geometry><material name="rubber"/></visual>
    <visual><origin xyz="0 -0.045 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.065" length="0.012"/></geometry><material name="teal"/></visual>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.26 0"/><axis xyz="0 1 0"/>
  </joint>
  <link name="caster_link">
    <visual><geometry><sphere radius="0.055"/></geometry><material name="metal"/></visual>
  </link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="-0.24 0 -0.105"/></joint>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.055" length="0.065"/></geometry><material name="rubber"/></visual>
    <visual><origin xyz="0 0 0.025"/><geometry><cylinder radius="0.056" length="0.015"/></geometry><material name="teal"/></visual>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.23 0 0.20"/></joint>

  <link name="arm_base">
    <visual><geometry><cylinder radius="0.085" length="0.13"/></geometry><material name="metal"/></visual>
  </link>
  <joint name="arm_mount" type="fixed"><parent link="base_link"/><child link="arm_base"/><origin xyz="-0.07 0 0.22"/></joint>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.16"/><geometry><box size="0.09 0.09 0.32"/></geometry><material name="shell"/></visual>
    <visual><geometry><sphere radius="0.075"/></geometry><material name="teal"/></visual>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base"/><child link="upper_arm"/><origin xyz="0 0 0.07"/><axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="30" velocity="0.8"/>
  </joint>
  <link name="forearm">
    <visual><origin xyz="0 0 0.13"/><geometry><box size="0.075 0.075 0.26"/></geometry><material name="shell"/></visual>
    <visual><geometry><sphere radius="0.065"/></geometry><material name="teal"/></visual>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.32"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="20" velocity="1"/>
  </joint>
  <link name="tool0">
    <visual><geometry><box size="0.12 0.07 0.035"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="0.045 0 0.04"/><geometry><box size="0.025 0.04 0.08"/></geometry><material name="teal"/></visual>
    <visual><origin xyz="-0.045 0 0.04"/><geometry><box size="0.025 0.04 0.08"/></geometry><material name="teal"/></visual>
  </link>
  <joint name="tool_joint" type="fixed">
    <parent link="forearm"/><child link="tool0"/><origin xyz="0 0 0.28"/>
  </joint>
</robot>
