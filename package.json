{
  "name": "roboquest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json docs README.md",
    "verify": "npm run lint && npm run build && npm run typecheck && npm test && npm run test:e2e && npm audit",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "export:robot": "tsx scripts/export-robot.ts",
    "prepare:editor": "node scripts/prepare-editor.mjs",
    "postinstall": "npm run prepare:editor"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.4.14",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.41.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "roslib": "^2.1.0",
    "three": "^0.185.1",
    "urdf-loader": "^0.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/roslib": "^1.3.5",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "^3.4.14"
  }
}
